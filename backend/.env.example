# ── Gemini (LLM explain + Q&A layer) ─────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev; swap for PostgreSQL DSN in production
DATABASE_URL=sqlite:///./recon_agent.db

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development    # development | production
LOG_LEVEL=INFO
